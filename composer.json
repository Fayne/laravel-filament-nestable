{
    "name": "fayne/laravel-filament-nestable",
    "description": "Scoped adjacency-list trees and Filament tree editing.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "laravel/framework": "^13.0",
        "filament/filament": "^5.0",
        "livewire/livewire": "^4.4.8"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.1",
        "laravel/pint": "^1.27"
    },
    "autoload": {
        "psr-4": {
            "Fayne\\FilamentNestable\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Fayne\\FilamentNestable\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "format": "pint --test"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Fayne\\FilamentNestable\\NestableServiceProvider"
            ]
        }
    }
}
